# Phase 7: static startup data and account-owned character enumeration.
[network]
listen = 127.0.0.1:8085
max_connections = 64
auth_timeout = 10s
idle_timeout = 2m
request_timeout = 10s

[world]
realm_id = 1
send_queue = 64
# Mirrors AllowTwoSide.Accounts: allow Alliance and Horde characters on one
# account on PvP realms (realmlist.icon 1, 8 or 16). Default false.
allow_two_side_accounts = false
# Mirrors mangosd.conf GameType (0 Normal, 1 PvP, 6 RP, 8 RP-PvP, 16 FFA-PvP).
# World::IsPvPRealm reads THIS value in the reference. -1 (default) = use the
# realmlist.icon of this realm instead.
game_type = -1

[database.login]
host = 127.0.0.1
port = 3306
name = realmd
user = root
password = 'mangos'

[logging]
level = debug
color = auto

[database.world]
host = 127.0.0.1
port = 3306
name = mangos1
user = root
password = 'mangos'

[data]
dbc_path = dbc
dbc_locale = 0
load_timeout = 10m

[database.characters]
host = 127.0.0.1
port = 3306
name = character1
user = root
password = 'mangos'
